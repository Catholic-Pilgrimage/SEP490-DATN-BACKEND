# Server Configuration
PORT=3000
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_DIALECT=postgres

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Your App Name

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://your-frontend-domain.com,https://sep490-datn-frontend.vercel.app

# Swagger Authentication
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=admin@123

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# VBee Text-to-Speech Configuration (for 3D model narration)
VBEE_API_KEY=your_vbee_api_key

# Google AI (Gemini) Configuration
GOOGLE_AI_KEY=your_google_ai_key
GOOGLE_AI_KEY_ROUTE=your_google_ai_key_route
GOOGLE_AI_KEY_ARTICLE=your_google_ai_key_article
GOOGLE_AI_KEY_REVIEW_SUMMARY=your_google_ai_key_review_summary
GOOGLE_AI_KEY_EVENTS=your_google_ai_key_events
GOOGLE_AI_KEY_PRAYER=your_google_ai_key_prayer

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\n-----END PRIVATE KEY-----"

# PayOS Configuration - Thu tiền (Receive/Topup)
PAYOS_RECEIVE_CLIENT_ID=your_receive_client_id
PAYOS_RECEIVE_API_KEY=your_receive_api_key
PAYOS_RECEIVE_CHECKSUM_KEY=your_receive_checksum_key

# PayOS Configuration - Chi tiền (Payout/Withdraw)
PAYOS_PAYOUT_CLIENT_ID=your_payout_client_id
PAYOS_PAYOUT_API_KEY=your_payout_api_key
PAYOS_PAYOUT_CHECKSUM_KEY=your_payout_checksum_key

# PayOS URLs
PAYOS_RETURN_URL=https://your-app.com/payment/success
PAYOS_CANCEL_URL=https://your-app.com/payment/cancel
